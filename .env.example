# Frontend: publishable key is safe to expose only while RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend server configuration. Never prefix server secrets with VITE_ or commit them.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Legacy alternative if your project still uses the JWT service-role key:
SUPABASE_SERVICE_ROLE_KEY=
# Public key used by the backend's isolated password-login client:
SUPABASE_PUBLISHABLE_KEY=

# Required application security configuration.
JWT_SECRET=
APP_ORIGIN=https://YOUR_STAGING_DOMAIN

# Optional one-time admin bootstrap. Keep disabled/empty after initial setup.
ADMIN_USERNAME=Admin
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# External scouting research providers. MESSINHO scoring and learning remain provider-independent.
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PORT=3000
