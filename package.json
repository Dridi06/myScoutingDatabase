{
  "name": "myscoutingdatabase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm test && find backend -maxdepth 1 -type f -name '*.js' -print0 | xargs -0 -n1 node --check && node ./node_modules/vite/bin/vite.js build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "rate-limiter-flexible": "^7.1.0",
    "zod": "^4.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  }
}
